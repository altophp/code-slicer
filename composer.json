{
    "name": "alto/code-slicer",
    "description": "Extract immutable source-code slices by line, text, or language structure while preserving exact byte ranges and line numbers.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "code",
        "source-code",
        "code-extraction",
        "snippet",
        "source-range",
        "line-numbers",
        "php",
        "javascript",
        "typescript",
        "css",
        "twig"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "homepage": "https://altophp.com/code-slicer",
    "support": {
        "issues": "https://github.com/altophp/code-slicer/issues",
        "source": "https://github.com/altophp/code-slicer",
        "docs": "https://altophp.com/code-slicer"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/smnandre"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-tokenizer": "*",
        "alto/language": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Alto\\Code\\Slicer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\Code\\Slicer\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs:fix": "vendor/bin/php-cs-fixer fix --sequential",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "vendor/bin/phpunit"
    }
}
